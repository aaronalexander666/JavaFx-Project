<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cts.javafxdemo.StaffDashboardController">
    <children>
        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="welcomeLabel" text="Staff Portal">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleRefresh" text="Refresh" />
                        <Button mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
                    </children>
                </HBox>

                <Separator />

                <!-- All Bookings Table -->
                <TitledPane animated="false" text="All Bookings" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="10.0">
                            <children>
                                <TableView fx:id="bookingsTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colBookingId" prefWidth="80.0" text="Booking ID" />
                                        <TableColumn fx:id="colCustomer" prefWidth="150.0" text="Customer" />
                                        <TableColumn fx:id="colRoom" prefWidth="100.0" text="Room" />
                                        <TableColumn fx:id="colDates" prefWidth="200.0" text="Dates" />
                                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                                        <TableColumn fx:id="colAmount" prefWidth="100.0" text="Amount" />
                                    </columns>
                                </TableView>

                                <HBox spacing="10.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#handleConfirm" text="Confirm" />
                                        <Button mnemonicParsing="false" onAction="#handleCheckIn" text="Check In" />
                                        <Button mnemonicParsing="false" onAction="#handleCheckOut" text="Check Out" />
                                        <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel Booking" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#handlePrintQuote" text="Print Quote" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>