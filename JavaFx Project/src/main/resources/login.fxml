<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" prefWidth="400.0" prefHeight="500.0"
      style="-fx-background-color: #f4f4f4; -fx-border-color: #dcdcdc; -fx-border-width: 2;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cts.javafxdemo.LoginController">

    <children>
        <Label text="Grand Horizon Hotel">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label text="Please login to continue" textFill="#666666" />

        <GridPane hgap="10.0" vgap="15.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
            </padding>
            <columnConstraints>
                <Constraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                <Constraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <children>
                <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtUsername" promptText="Enter username"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <PasswordField fx:id="txtPassword" promptText="Enter password"
                               GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Login As:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbUserType" prefWidth="180.0" promptText="Select Role"
                          GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <VBox alignment="CENTER" spacing="10.0">
            <Button fx:id="btnLogin" onAction="#handleLogin" prefWidth="280.0"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand;" text="Login">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>

            <Hyperlink onAction="#handleShowRegister" text="Don't have an account? Register here" />

            <Label fx:id="lblMessage" textFill="#e74c3c">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
        </VBox>

        <Separator prefWidth="200.0" />
        <Label text="© 2026 CTS College Project" textFill="#999999">
            <font>
                <Font size="10.0" />
            </font>
        </Label>
    </children>
</VBox>