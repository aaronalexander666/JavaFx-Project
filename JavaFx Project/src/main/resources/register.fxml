<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cts.javafxdemo.RegisterController">
    <children>
        <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="Create New Account">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
                        <ColumnConstraints minWidth="250.0" prefWidth="250.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Username:" GridPane.rowIndex="0" />
                        <TextField fx:id="usernameField" promptText="Choose a username" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Password:" GridPane.rowIndex="1" />
                        <PasswordField fx:id="passwordField" promptText="Choose a password" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Full Name:" GridPane.rowIndex="2" />
                        <TextField fx:id="fullNameField" promptText="Your full name" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Email:" GridPane.rowIndex="3" />
                        <TextField fx:id="emailField" promptText="your@email.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Phone:" GridPane.rowIndex="4" />
                        <TextField fx:id="phoneField" promptText="Phone number" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Address:" GridPane.rowIndex="5" />
                        <TextArea fx:id="addressField" prefHeight="60.0" promptText="Your address" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </children>
                </GridPane>

                <Label fx:id="statusLabel" text="" />

                <HBox spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleRegister" prefWidth="100.0" text="Register" />
                        <Button mnemonicParsing="false" onAction="#handleBack" prefWidth="100.0" text="Back to Login" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>