<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.cts.javafxdemo.CustomerListReportController" prefHeight="600.0" prefWidth="1000.0">
    <children>
        <Label text="Hotel Guest Management System" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <TableView fx:id="tblCustomers" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCustomerId" text="ID" prefWidth="50" />
                <TableColumn fx:id="colBusinessName" text="Business" prefWidth="120" />
                <TableColumn fx:id="colFirstname" text="First Name" prefWidth="100" />
                <TableColumn fx:id="colLastname" text="Last Name" prefWidth="100" />
                <TableColumn fx:id="colCity" text="City" prefWidth="100" />
                <TableColumn fx:id="colMobilePhone" text="Mobile" prefWidth="100" />
                <TableColumn fx:id="colBusinessPhone" text="Bus. Phone" prefWidth="100" />
                <TableColumn fx:id="colEmail" text="Email" prefWidth="150" />
                <TableColumn fx:id="colType" text="Type" prefWidth="80" />
            </columns>
        </TableView>
        <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10;">
            <Button fx:id="btnPrintToPdf" text="Export Customer Report (PDF)" onAction="#printToPdf" 
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </children>
</VBox>
